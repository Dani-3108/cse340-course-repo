<%- include('../partials/header.ejs') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are some of our current service projects:</p>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <%= new Date(project.project_date).toLocaleDateString() %>: <%= project.title %> (<em>
                                <%= project.org_name %>
                            </em>)
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('../partials/footer.ejs') %>