<%- include('../partials/header.ejs') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are some of our current service projects:</p>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <%= new Date(project.project_date).toLocaleDateString() %>:
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        (<em><a href="/organization/<%= project.organization_id %>">
                                <%= project.org_name %>
                            </a></em>)
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-project">Add a New Service Project</a></p>
        <% } %>
    </main>
    <%- include('../partials/footer.ejs') %>