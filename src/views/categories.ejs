<%- include('../partials/header.ejs') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Here are some of our service project categories</h2>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                    <a href="/edit-category/<%= category.category_id %>">Edit</a>
                </li>
                <% }); %>
        </ul>
        <p><a href="/new-category">Add a new category</a></p>
    </main>
    <%- include('../partials/footer.ejs') %>