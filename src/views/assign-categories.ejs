<%- include('../partials/header.ejs') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <form action="/assign-categories/<%= projectDetails.project_id %>" method="POST">
            <% allCategories.forEach(category=> { %>
                <% const isAssigned=assignedCategories.some(assigned=> assigned.category_id === category.category_id);
                    %>
                    <div class="form-group">
                        <label for="category-<%= category.category_id %>">
                            <input type="checkbox" id="category-<%= category.category_id %>" name="categoryIds"
                                value="<%= category.category_id %>" <%=isAssigned ? 'checked' : '' %>
                            />
                            <%= category.category_name %>
                        </label>
                    </div>
                    <% }); %>

                        <button type="submit">Save Categories</button>
        </form>
    </main>
    <%- include('../partials/footer.ejs') %>