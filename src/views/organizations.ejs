<%- include('../partials/header.ejs') %>
<main>
    <h1>
         <%= title %>
    </h1>
    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% organizations.forEach(organization=> { %>
            <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.org_name %> logo"><a href="/organization/<%= organization.organization_id %>"><strong>
                    <%= organization.org_name %>
                </strong></a><%= organization.org_description %> <%= organization.contact_email %>
            </li>
            <% }); %>
    </ul>
    <% if (user && user.role_name==='admin' ) { %>
        <p><a href="/new-organization">Add a new organization</a></p>
    <% } %>
</main>
 <%- include('../partials/footer.ejs') %>