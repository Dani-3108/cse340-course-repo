<%- include('../partials/header.ejs') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/all-users">View All Users</a></p>
            <% } %>

                <h3>My Volunteered Projects</h3>
                <% if (volunteeredProjects.length===0) { %>
                    <p>You haven't volunteered for any projects yet.</p>
                    <% } else { %>
                        <ul>
                            <% volunteeredProjects.forEach(project=> { %>
                                <li>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                    — <%= new Date(project.project_date).toLocaleDateString() %>, <%= project.location
                                            %>
                                            <form action="/project/<%= project.project_id %>/remove-volunteer"
                                                method="POST">
                                                <button type="submit">Remove</button>
                                            </form>
                                </li>
                                <% }); %>
                        </ul>
                        <% } %>
    </main>
    <%- include('../partials/footer.ejs') %>