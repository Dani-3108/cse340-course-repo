<%- include('../partials/header.ejs') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>Description: <%= projectDetails.description %>
        </p>
        <p>Date: <%= projectDetails.project_date %>
        </p>
        <p>Location: <%= projectDetails.location %>
        </p>

        <p>Partner Organization:
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.org_name %>
            </a>
        </p>

        <p>Categories:
            <% categories.forEach(category=> { %>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
                <% }); %>
        </p>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>
            <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
            <% } %>

                <% if (user) { %>
                    <% if (hasVolunteered) { %>
                        <form action="/project/<%= projectDetails.project_id %>/remove-volunteer" method="POST">
                            <button type="submit">Remove Volunteering</button>
                        </form>
                        <% } else { %>
                            <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                                <button type="submit">Volunteer</button>
                            </form>
                            <% } %>
                                <% } %>
    </main>
    <%- include('../partials/footer.ejs') %>